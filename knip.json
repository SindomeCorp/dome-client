{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/server.js",
    "src/env.js",
    "src/client/entrypoints/index.js",
    "src/client/entrypoints/*.js",
    "src/client/entrypoints/*.jsx",
    "src/client/entrypoints/ejs-scripts/*.js",
    "src/services/build.js",
    "test/**/*.js",
    "eslint.config.js",
    "postcss.config.js",
    "stryker*.json"
  ],
  "project": [
    "src/**/*.js",
    "src/**/*.jsx",
    "test/**/*.js",
    "less/**/*.less",
    "views/**/*.ejs",
    "scripts/**/*.{awk,sh}",
    "*.js",
    "*.json"
  ],
  "ignore": [
    "coverage/**",
    "data/**",
    "docs/**",
    "node_modules/**",
    "public/**",
    "reports/**",
    ".stryker-tmp/**",
    "src/client/features/editor/ace/mode-moo.js"
  ],
  "ignoreDependencies": [
    "@stryker-mutator/command-runner"
  ],
  "ignoreIssues": {
    "src/client/core/preferences.js": [
      "exports"
    ],
    "src/client/core/store.js": [
      "exports"
    ],
    "src/client/features/terminal/buttons.js": [
      "exports"
    ],
    "src/client/core/bootstrap.js": [
      "exports"
    ],
    "src/controllers/socket.js": [
      "exports"
    ],
    "src/middleware/error.js": [
      "exports"
    ],
    "package.json": [
      "binaries"
    ]
  }
}
