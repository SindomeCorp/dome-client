<%- include('../shells/child-window-header', { deviceWidthViewport: true }) -%>
<div class="editor note-popup">
  <div class="menu">
    <% if ( !editor.readonly ) { %>
      <button class="btn btn-danger abort pull-left">CLOSE</button>
      <button class="btn btn-success upload pull-right" data-command="">LOADING ...</button>
    <% } else { %>
      <button class="btn btn-danger abort pull-left">CLOSE</button>
      <button class="btn pull-right">READ-ONLY</button>
    <% } %>
    <div class="verb-status"><span class="status" role="status"></span></div>
  </div>
  <div class="note-header">
    <div class="note-authors"><span class="header-label">By</span><span class="header-value"></span></div>
    <div class="note-timestamp"><span class="header-label">Noted</span><span class="header-value"></span></div>
    <div class="note-subject"><span class="header-label">Subject</span><span class="header-value"></span></div>
    <div class="note-objects"><span class="header-label">Applies To</span><span class="header-value"></span></div>
  </div>
    <textarea class="basic-textarea" rows="15" cols="50"></textarea>
</div>
<script type="module" src="/js/note-editor-window.js"></script>
<%- include('../shells/child-window-footer') -%>
