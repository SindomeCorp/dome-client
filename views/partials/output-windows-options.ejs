<div class="output-window-options">
  <label for="output-layout">Output layout</label>
  <select id="output-layout">
    <option value="single">Single window</option>
    <option value="right">Secondary on right</option>
    <option value="left">Secondary on left</option>
    <option value="bottom">Secondary below</option>
    <option value="top">Secondary above</option>
  </select>
  <p>Selected filters move future matching lines to the secondary window while a split is open. Existing output stays where it is.</p>
  <div id="output-presets" class="output-rule-list"></div>
  <div id="output-custom-rules" class="output-rule-list"></div>
  <div id="output-rule-error" role="alert"></div>
  <form id="output-rule-form">
    <h3>Custom output filter</h3>
    <label for="output-rule-name">Name</label>
    <input id="output-rule-name" type="text" required />
    <label for="output-rule-pattern">Pattern (without / delimiters)</label>
    <input id="output-rule-pattern" type="text" required placeholder="^\[-\]\[Team-Chat\]" spellcheck="false" />
    <label><input id="output-rule-case" type="checkbox" /> Ignore case</label>
    <label for="output-rule-sample">Sample text</label>
    <textarea id="output-rule-sample" rows="4" placeholder="Paste example output here"></textarea>
    <div>
      <button type="button" id="output-rule-test" class="btn">Test</button>
      <button type="submit" id="output-rule-save" class="btn btn-primary">Add filter</button>
      <button type="button" id="output-rule-cancel" class="btn hide">Cancel edit</button>
    </div>
    <pre id="output-rule-test-result" role="status"></pre>
  </form>
</div>
