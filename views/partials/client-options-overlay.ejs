<div id="client-options-overlay" class="hide">
  <div class="client-options-page">
    <div class="well">
      <div class="options-top">
        <div id="client-options-save-indicator" class="hide">Saved</div>
        <button id="button-client-options-close" class="options-close" aria-label="Close">&times;</button>
      </div>
      <h1>Client Options</h1>
      <div class="client-options-tabs" role="tablist" aria-label="Client options sections">
        <button type="button" id="client-options-tab-general" class="client-options-tab active" role="tab" aria-selected="true" aria-controls="client-options-panel-general" data-tab="general">General</button>
        <button type="button" id="client-options-tab-fonts" class="client-options-tab" role="tab" aria-selected="false" aria-controls="client-options-panel-fonts" data-tab="fonts">Presentation</button>
        <button type="button" id="client-options-tab-editor" class="client-options-tab" role="tab" aria-selected="false" aria-controls="client-options-panel-editor" data-tab="editor">Local Editor</button>
        <button type="button" id="client-options-tab-importexport" class="client-options-tab" role="tab" aria-selected="false" aria-controls="client-options-panel-importexport" data-tab="importexport">Import/Export</button>
      </div>
      <div id="client-options-panel-general" class="client-options-panel" role="tabpanel" aria-labelledby="client-options-tab-general" data-tab-panel="general">
        <div class="option-row" id="localecho-option">
          <span class="option-label"><%= clientOptionLabels.localecho %></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true">Yes</button>
            <button class="btn disabled-state" data-val="false">No</button>
          </div>
        </div>
        <div class="option-row" id="commands-option">
          <span class="option-label"><%= clientOptionLabels.commands %></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true">Yes</button>
            <button class="btn disabled-state" data-val="false">No</button>
          </div>
        </div>
        <div class="option-row" id="buffer-option">
          <span class="option-label"><%= clientOptionLabels.buffer %> <i class="glyphicon glyphicon-question-sign" title="This defines the length of your buffer. 0 is infinite (best for logging). Adjust this to a lower number if you are having performance issues. Warning: Your current buffer is saved with the 'Log' button, so lower numbers mean a shorter log."></i></span>
          <div class="option-choices pull-right">
            <input name="buffer-size" placeholder="0" type="number" min="0" max="96000" value="0" />
          </div>
        </div>
        <div class="option-row" id="broadly-option">
          <span class="option-label"><%= clientOptionLabels.broadly %></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true" title="Search command instructions and requirements when Command Hints are enabled.">Yes</button>
            <button class="btn disabled-state" data-val="false" title="Just search command syntax when Command Hints are enabled. This can be helpful for performance.">No</button>
          </div>
        </div>
        <% if (shortenEnabled) { %>
        <div class="option-row" id="shorten-option">
          <span class="option-label"><%= clientOptionLabels.shorten %></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true">Yes</button>
            <button class="btn disabled-state" data-val="false">No</button>
          </div>
        </div>
        <% } %>
        <div class="option-row" id="imageview-option">
          <span class="option-label"><%= clientOptionLabels.imageview %></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true">Yes</button>
            <button class="btn disabled-state" data-val="false">No</button>
          </div>
        </div>
        <div class="option-row" id="playding-option">
          <span class="option-label"><%= clientOptionLabels.playding %></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" title="When the window is out of focus, play a notification sound when your login name is seen in the scrollback." data-val="true">Yes</button>
            <button class="btn disabled-state" data-val="false">No</button>
          </div>
        </div>
        <div class="option-row" id="scroll-option">
          <span class="option-label pull-left"><%= clientOptionLabels.scroll %></span>
          <select name="auto-scroll-toggle">
            <% clientOptionView.scroll.choices.forEach(function(choice) { %>
            <option value="<%= choice.value %>"<% if (choice.value === "dbl") { %> selected="selected"<% } %>><%= choice.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="option-row" id="scrolluppause-option">
          <span class="option-label"><%= clientOptionLabels.scrolluppause %> <i class="glyphicon glyphicon-question-sign" title="When enabled, scrolling up in the output buffer pauses automatic scroll-to-bottom so new text does not pull you away from what you are reading. Scroll back to the bottom to resume normal automatic scrolling."></i></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true" title="Pause automatic scrolling when you scroll up in the output buffer.">Yes</button>
            <button class="btn disabled-state" data-val="false" title="Keep automatic scrolling behavior controlled only by the pause/resume controls.">No</button>
          </div>
        </div>
        <div class="option-row" id="transparent-option">
          <span class="option-label"><%= clientOptionLabels.transparent %></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true" title="Make dialogs for autocomplete, help, etc transparent enough to see MOO text underneath.">Yes</button>
            <button class="btn disabled-state" data-val="false" title="Make dialogs for autocomplete, help, etc opaque. This can be helpful for performance.">No</button>
          </div>
        </div>
        <div class="option-row" id="logcss-option">
          <span class="option-label"><%= clientOptionLabels.logcss %></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true" title="Default: save logs with inline stylesheet for fully self-contained files.">Yes</button>
            <button class="btn disabled-state" data-val="false" title="Legacy mode: save logs that link to https://sindome.org/css/dome.css for smaller files.">No</button>
          </div>
        </div>
        <div class="option-row" id="sdwcnowrap-option">
          <span class="option-label"><%= clientOptionLabels.sdwcnowrap %> <i class="glyphicon glyphicon-question-sign" title="With this option enabled, the client will create non-wrapped content that can be horizontally scrolled for text that the MOO deems should be visually presented as is, and not wrapped on small screens."></i></span>
          <div class="option-choices pull-right">
            <button class="btn enabled-state" data-val="true" title="Render SDWC-START-NOWRAP/SDWC-END-NOWRAP sections in a horizontal-scroll block without text wrapping.">Yes</button>
            <button class="btn disabled-state" data-val="false" title="Ignore SDWC nowrap markers and keep normal line wrapping.">No</button>
          </div>
        </div>
      </div>
      <div id="client-options-panel-fonts" class="client-options-panel hide" role="tabpanel" aria-labelledby="client-options-tab-fonts" data-tab-panel="fonts">
        <div class="option-row" id="outfont-option">
          <span class="option-label"><%= clientOptionLabels.outfont %></span>
          <select name="output-font-choice">
            <% clientOptionView.outfont.choices.forEach(function(choice) { %>
            <option value="<%= choice.value %>" style="<%= choice.style %>"<% if (choice.value === "standard") { %> selected="selected"<% } %>><%= choice.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="option-row" id="outfontsize-option">
          <span class="option-label"><%= clientOptionLabels.outfontsize %></span>
          <div class="option-choices pull-right">
            <input name="output-font-size" type="number" min="8" max="24" step="0.25" value="9.75" />
          </div>
        </div>
        <div class="option-row" id="editorfont-option">
          <span class="option-label"><%= clientOptionLabels.editorfont %></span>
          <select name="editor-font-choice">
            <% clientOptionView.editorfont.choices.forEach(function(choice) { %>
            <option value="<%= choice.value %>" style="<%= choice.style %>"<% if (choice.value === "standard") { %> selected="selected"<% } %>><%= choice.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="option-row" id="inputfont-option">
          <span class="option-label"><%= clientOptionLabels.inputfont %></span>
          <select name="input-font-choice">
            <% clientOptionView.inputfont.choices.forEach(function(choice) { %>
            <option value="<%= choice.value %>" style="<%= choice.style %>"<% if (choice.value === "standard") { %> selected="selected"<% } %>><%= choice.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="option-row" id="inputfontsize-option">
          <span class="option-label"><%= clientOptionLabels.inputfontsize %></span>
          <div class="option-choices pull-right">
            <input name="input-font-size" type="number" min="8" max="24" step="0.5" value="11" />
          </div>
        </div>
        <div class="option-row" id="inputfontcolor-option">
          <span class="option-label"><%= clientOptionLabels.inputfontcolor %></span>
          <div class="option-choices pull-right color-choice">
            <input name="input-font-color-picker" type="color" value="#EEEEEE" aria-label="Input font color picker" />
            <input name="input-font-color-hex" type="text" value="#EEEEEE" maxlength="7" data-color-hex="true" inputmode="text" autocapitalize="none" autocomplete="off" autocorrect="off" aria-label="Input font color hex" />
          </div>
        </div>
        <div class="option-row" id="inputbgcolor-option">
          <span class="option-label"><%= clientOptionLabels.inputbgcolor %></span>
          <div class="option-choices pull-right color-choice">
            <input name="input-bg-color-picker" type="color" value="#333333" aria-label="Input background color picker" />
            <input name="input-bg-color-hex" type="text" value="#333333" maxlength="7" data-color-hex="true" inputmode="text" autocapitalize="none" autocomplete="off" autocorrect="off" aria-label="Input background color hex" />
          </div>
        </div>
        <div class="option-row" id="colorset-option">
          <span class="option-label"><%= clientOptionLabels.colorset %></span>
          <select name="colorset-choice">
            <% clientOptionView.colorset.choices.forEach(function(choice) { %>
            <option value="<%= choice.value %>"<% if (choice.value === "normal") { %> selected="selected"<% } %>><%= choice.label %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div id="client-options-panel-editor" class="client-options-panel hide" role="tabpanel" aria-labelledby="client-options-tab-editor" data-tab-panel="editor">
        <div class="option-row" id="edittype-option">
          <span class="option-label"><%= clientOptionLabels.edittype %></span>
          <select name="editor-type-choice">
            <% clientOptionView.edittype.choices.forEach(function(choice) { %>
            <option value="<%= choice.value %>"<% if (choice.value === "ide") { %> selected="selected"<% } %>><%= choice.label %></option>
            <% }); %>
          </select>
        </div>
        <div class="option-row" id="edittheme-option">
          <span class="option-label"><%= clientOptionLabels.edittheme %></span>
          <select name="editor-theme-choice">
            <% clientOptionView.edittheme.choices.forEach(function(choice) { %>
            <option value="<%= choice.value %>"<% if (choice.value === "twilight") { %> selected="selected"<% } %>><%= choice.label %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div id="client-options-panel-importexport" class="client-options-panel hide" role="tabpanel" aria-labelledby="client-options-tab-importexport" data-tab-panel="importexport">
        <div id="client-options-import-export-indicator" class="hide" aria-live="polite">Saved</div>
        <div class="option-row" id="options-export-row">
          <span class="option-label">Export Preferences</span>
          <div class="option-choices pull-right">
            <button id="client-options-export" class="btn btn-primary import-export-action" type="button">Export File</button>
          </div>
        </div>
        <div class="option-row" id="options-import-row">
          <span class="option-label">Import Preferences</span>
          <div class="option-choices pull-right">
            <input id="client-options-import-file" type="file" accept=".json,application/json" class="hide" />
            <button id="client-options-import" class="btn import-export-action" type="button">Import File</button>
          </div>
        </div>
        <div class="option-row" id="options-reset-row">
          <span class="option-label">Reset Preferences</span>
          <div class="option-choices pull-right">
            <button id="client-options-reset-defaults" class="btn import-export-action" type="button">Reset to Defaults</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
