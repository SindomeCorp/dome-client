<p id="context-menu-active" role="status">Active Profile: Player (Fallback)</p>
<p>Right click on text to show a context menu with options. Use Shift+F10 on a focused output row for keyboard access. Shift-right-click keeps the browser menu.</p>
<div class="context-menu-tabs" role="tablist" aria-label="Context menu settings">
  <button type="button" id="context-menu-tab-basic" class="context-menu-tab btn btn-default active" role="tab" aria-selected="true" aria-controls="context-menu-panel-basic" tabindex="0" data-context-tab="basic">Basic</button>
  <button type="button" id="context-menu-tab-advanced" class="context-menu-tab btn btn-default" role="tab" aria-selected="false" aria-controls="context-menu-panel-advanced" tabindex="-1" data-context-tab="advanced">Advanced</button>
</div>
<div id="context-menu-panel-basic" role="tabpanel" aria-labelledby="context-menu-tab-basic" data-context-panel="basic">
  <label class="context-option"><input id="context-menu-override" type="checkbox" /> Override server context menu selection</label>
  <label class="context-option">Override profile <select id="context-menu-profile" disabled aria-describedby="context-menu-permissions"></select></label>
  <p id="context-menu-permissions">These choices apply across all connections. The game always enforces command permissions.</p>
</div>
<div id="context-menu-panel-advanced" class="hide" role="tabpanel" aria-labelledby="context-menu-tab-advanced" data-context-panel="advanced">
  <label class="context-option" for="context-menu-json">Context menu JSON</label>
  <textarea id="context-menu-json" rows="16" spellcheck="false" aria-describedby="context-menu-source context-menu-error"></textarea>
  <p id="context-menu-source">Edit JSON here or import a file. Reload validates and saves a browser-local copy for restart. To read later edits to a disk file, select it again.</p>
  <label class="context-option">Import JSON <input id="context-menu-file" type="file" accept=".json,application/json" /></label>
  <button id="context-menu-reload" type="button" class="btn btn-primary">Reload context menus</button>
  <button id="context-menu-export" type="button" class="btn btn-default">Export JSON</button>
  <p id="context-menu-error" role="alert"></p>
</div>
